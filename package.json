{
  "name": "pixelforge-launcher",
  "version": "1.0.0",
  "description": "A modern Minecraft launcher built with Electron and Vue 3",
  "main": "dist/main/main.js",
  "homepage": "./",
  "author": "MakeForge / PixelForge Studios",
  "license": "MIT",
  "scripts": {
    "dev": "npm run build:main && concurrently \"npm run dev:vite\" \"wait-on http://localhost:5173 && npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "electron .",
    "build": "npm run build:vite && npm run build:main && npm run build:electron",
    "build:vite": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:electron": "electron-builder -w",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@xmcl/core": "^2.0.0",
    "@xmcl/curseforge": "^2.0.0",
    "@xmcl/game-data": "^1.0.0",
    "@xmcl/installer": "^6.0.0",
    "@xmcl/modrinth": "^2.0.0",
    "@xmcl/nbt": "^3.0.0",
    "@xmcl/resourcepack": "^1.0.0",
    "@xmcl/user": "^4.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0",
    "pinia": "^2.2.0",
    "vuetify": "^3.6.0",
    "@mdi/font": "^7.0.0",
    "axios": "^1.7.0",
    "gsap": "^3.12.0",
    "animate.css": "^4.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.1.0",
    "vite": "^5.2.0",
    "typescript": "^5.4.0",
    "vue-tsc": "^3.3.0",
    "concurrently": "^9.0.0",
    "wait-on": "^8.0.0",
    "@types/node": "^20.0.0"
  },
  "build": {
    "appId": "com.pixelforge.launcher",
    "productName": "PixelForge Launcher",
    "directories": {
      "buildResources": "assets/icons",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "pnpm": {
    "overrides": {
      "@xmcl/unzip": "^2.1.2"
    }
  }
}

